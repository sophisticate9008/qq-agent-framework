{
  "name": "qq-agent-framework",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, capability-oriented bridge engine with separated persona, preferences and policy.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "qq-agent": "scripts/cli.ts"
  },
  "scripts": {
    "start": "node scripts/cli.ts start",
    "cli": "node scripts/cli.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node scripts/cli.ts test",
    "test:built": "npm run build && node --test dist/test/*.test.js",
    "test:browser": "node scripts/cli.ts test --browser",
    "test:management": "node scripts/cli.ts test --browser --target management",
    "test:page-navigation": "node scripts/cli.ts test --browser --target page-navigation",
    "test:activity": "node scripts/cli.ts test --browser --target activity",
    "test:usage": "node scripts/cli.ts test --browser --target usage",
    "test:markdown-smoke": "node scripts/cli.ts test --browser --target markdown",
    "test:presentation-smoke": "node scripts/cli.ts test --browser --target presentation",
    "test:virtual-list-perf": "node scripts/cli.ts test --browser --target virtual-list-perf",
    "test:native-chat-ui": "node scripts/cli.ts test --browser --target native-chat-ui",
    "demo": "npm run build && node src/demo.ts",
    "check": "npm run typecheck && node scripts/check.ts",
    "bench:core": "node --expose-gc scripts/bench-core.ts",
    "bench:context": "node scripts/bench-context.ts",
    "bench:policy": "node scripts/bench-policy.ts",
    "bench:admin": "node scripts/bench-admin.ts",
    "bench:host": "node scripts/bench-host.ts",
    "bench:soak": "node --expose-gc scripts/bench-soak.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  }
}
