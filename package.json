{
  "name": "qq-agent-framework",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, capability-oriented bridge engine with separated persona, preferences and policy.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run build && node --test test/*.test.ts",
    "test:built": "npm run build && node --test dist/test/*.test.js",
    "test:browser": "npm run build && node scripts/browser-smoke.ts",
    "test:management": "npm run build && node scripts/management-smoke.ts",
    "test:markdown-smoke": "npm run build && node scripts/markdown-smoke.ts",
    "demo": "npm run build && node src/demo.ts",
    "check": "npm run typecheck && node scripts/check.ts",
    "bench:core": "node --expose-gc scripts/bench-core.ts",
    "bench:context": "node scripts/bench-context.ts",
    "bench:policy": "node scripts/bench-policy.ts",
    "bench:admin": "node scripts/bench-admin.ts",
    "bench:host": "node scripts/bench-host.ts",
    "bench:soak": "node --expose-gc scripts/bench-soak.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.61.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  }
}
