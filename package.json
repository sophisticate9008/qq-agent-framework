{
  "name": "qq-bridge-framework",
  "version": "1.6.0",
  "private": true,
  "description": "面向 QQ 会话的可扩展智能体框架，提供中文控制台、连续聊天与受控工具执行。AI许愿生成的，目前自用",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "qq-bridge-framework": "scripts/cli.ts",
    "qqbridge-framework": "ops/qqbridge-framework"
  },
  "scripts": {
    "start": "node scripts/cli.ts start",
    "cli": "node scripts/cli.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node scripts/cli.ts test",
    "test:all": "node scripts/cli.ts test --suite all",
    "test:artifacts": "node scripts/cli.ts test --suite artifacts",
    "test:built": "node scripts/cli.ts test --built",
    "test:fast": "node scripts/cli.ts test --suite fast",
    "test:deadline": "node scripts/cli.ts test --suite deadline",
    "test:integration": "node scripts/cli.ts test --suite integration",
    "test:browser": "node scripts/cli.ts test --browser",
    "test:management": "node scripts/cli.ts test --browser --target management",
    "test:page-navigation": "node scripts/cli.ts test --browser --target page-navigation",
    "test:activity": "node scripts/cli.ts test --browser --target activity",
    "test:usage": "node scripts/cli.ts test --browser --target usage",
    "test:markdown-smoke": "node scripts/cli.ts test --browser --target markdown",
    "test:presentation-smoke": "node scripts/cli.ts test --browser --target presentation",
    "test:virtual-list-perf": "node scripts/cli.ts test --browser --target virtual-list-perf",
    "test:native-chat-ui": "node scripts/cli.ts test --browser --target native-chat-ui",
    "test:execution-journal": "node scripts/cli.ts test --browser --target execution-journal",
    "demo": "npm run build && node src/demo.ts",
    "check": "npm run typecheck && node scripts/check.ts",
    "bench:core": "node --expose-gc scripts/bench-core.ts",
    "bench:context": "node scripts/bench-context.ts",
    "bench:policy": "node scripts/bench-policy.ts",
    "bench:admin": "node scripts/bench-admin.ts",
    "bench:host": "node scripts/bench-host.ts",
    "bench:soak": "node --expose-gc scripts/bench-soak.ts",
    "build:sdk": "node scripts/build-sdk.ts",
    "test:sdk": "node scripts/verify-sdk-package.ts",
    "ops": "node scripts/service-manager.ts",
    "release:pack": "node scripts/pack-release.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@takumi-rs/core": "2.18.2",
    "@takumi-rs/helpers": "2.18.2",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "mathjax": "3.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sophisticate9008/qq-bridge-framework.git"
  },
  "homepage": "https://github.com/sophisticate9008/qq-bridge-framework#readme",
  "bugs": {
    "url": "https://github.com/sophisticate9008/qq-bridge-framework/issues"
  }
}
